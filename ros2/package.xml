<?xml version="1.0"?>
<package format="3">
  <name>simple_visual_slam_ros2</name>
  <version>0.1.0</version>
  <description>Basic ROS 2 node wrapper for the SimpleVisualSLAM core library.</description>

  <maintainer email="maintainers@example.com">SimpleVisualSLAM contributors</maintainer>
  <license>BSD-2-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
